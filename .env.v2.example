# ── Resume Extractor v2 — environment ───────────────────────────────────────
# Copy to /opt/resume_v2/.env  (loaded by resume_v2.service via EnvironmentFile)

# Admin API key for /records, /records/{uid}, /training/export, /stats
RESUME_V2_KEY=CHANGE_THIS_TO_A_STRONG_SECRET

# ── Database ── pick ONE ─────────────────────────────────────────────────────
# Default: SQLite on the VPS (nothing to configure)
DATABASE_URL=sqlite:////opt/resume_v2/records.db
# AWS RDS Postgres:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST.rds.amazonaws.com:5432/DBNAME
# AWS RDS MySQL:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST.rds.amazonaws.com:3306/DBNAME
# MongoDB Atlas / AWS DocumentDB (takes priority over DATABASE_URL when set):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB=avr_resume_v2

# ── Optional: forward every reviewed candidate to the main AVR backend ──────
# REVIEW_WEBHOOK_URL=https://api.avrenergies.com/candidates/from-resume-v2
# REVIEW_WEBHOOK_KEY=secret_shared_with_backend

# ── Storage / limits ─────────────────────────────────────────────────────────
V2_BASE_DIR=/opt/resume_v2
V2_UPLOAD_DIR=/opt/resume_v2/uploads
V2_CERT_DIR=/opt/resume_v2/certificates
MAX_FILE_MB=10
MAX_CERT_MB=5
# MAX_RECORDS: 0 = keep all (training data); N = keep only the newest N
MAX_RECORDS=0

# ── Job titles (dropdown) ────────────────────────────────────────────────────
JOB_TITLE_API=https://api.avrenergies.com/job-posting/departments/with-job-titles
JOB_TITLE_TTL=3600

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://avrenergies.com,https://www.avrenergies.com,http://localhost:3000,http://localhost:5173

# ── OCR for scanned PDFs / images (needs tesseract-ocr or easyocr installed) ─
OCR_ENABLED=1
OCR_GPU=0
LOG_LEVEL=INFO
